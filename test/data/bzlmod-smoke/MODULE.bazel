module(
    name = "bzlmod-smoke",
    version = "1.0.0",
)

bazel_dep(name = "rules_go", version = "0.39.1")
bazel_dep(name = "rules_jvm_external", version = "5.3", repo_name = "rules_jvm")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.artifact("com.google.guava:guava:32.1.1-jre")
maven.artifact(group = "org.slf4j", artifact = "slf4j-api", version = "2.0.9")

use_repo(maven, "guava", "slf4j_api")
