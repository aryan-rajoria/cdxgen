{
  "include": ["*.js", "bin/**/*.js", "lib/**/*.js"],
  "exclude": [
    ".*/**",
    "*.poku.js",
    "lib/**/*.poku.js",
    "bin/**/*.poku.js",
    "types/**/*",
    "contrib/**"
  ],
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "allowJs": true,
    // Generate d.ts files
    "declaration": true,
    // This compiler run should
    // only output d.ts files
    "emitDeclarationOnly": true,
    "outDir": "types",
    "declarationMap": true,
    "skipLibCheck": true
  }
}
